<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Tests intentionally exercise obsolete APIs for compatibility coverage -->
    <NoWarn>$(NoWarn);CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Debug">
    <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Bunit" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Blazilla\Blazilla.csproj" />
  </ItemGroup>

  <!-- Framework-specific form components: .NET 11 uses native async EditForm validation -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Content Remove="Pages\Net11\**" />
    <None Include="Pages\Net11\**" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <Content Remove="Pages\Net10\**" />
    <None Include="Pages\Net10\**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Bunit" />
    <Using Include="Bunit.TestDoubles" />
    <Using Include="FluentValidation" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
